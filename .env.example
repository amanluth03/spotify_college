# Spotify app credentials — create an app at https://developer.spotify.com/dashboard
# Add redirect URIs:
#   http://127.0.0.1:3000/api/auth/callback/spotify   (local dev)
#   https://<your-domain>/api/auth/callback/spotify     (production)
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=generate-me

# Production only: set to your deployed URL (Auth.js infers this in dev).
# AUTH_URL=https://your-domain.vercel.app
